{
  "name": "redline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --import ./scripts/module-resolution.mjs scripts/smoke.ts",
    "eval": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local --import ./scripts/module-resolution.mjs scripts/eval.ts",
    "verify:corpus": "node --disable-warning=ExperimentalWarning --import ./scripts/module-resolution.mjs scripts/verify-corpus.ts",
    "check:citations": "node --experimental-strip-types scripts/check-citations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
